    "update": dict(
        title="Update the system",
        summary="Runs Omarchy's own update: it takes a snapshot, then updates Omarchy and every package.",
        system=False, steps=lambda o: [step("Update Omarchy and all packages", [OMARCHY, "update"], password=True)]),
    "cleanup": dict(
        title="Clean up",
        summary="Removes what you tick. Package files are deleted outright; you can download them again any time.",
