def _active(unit):
    return capture(["/usr/bin/systemctl", "is-active", "--", unit], timeout=3, cap=256).strip() == "active"


def _write_root(say, path, content):
    return step(say, ["/usr/bin/install", "-D", "-m", "0644", "-o", "root", "-g", "root", "-T", "/dev/stdin", path],
                root=True, stdin=content.encode())


def _remove_root(say, path):
    return step(say, ["/usr/bin/rm", "-f", "--", path], root=True)


def _replace_root(say, path, new, old):
    """Rewrite a file we don't own through a fresh sibling and a rename, then
    check it reads back exactly; if not, the original bytes go back."""
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".keepwell-new")
    def pair(data):
        return [step("Write the new " + path, ["/usr/bin/install", "-m", "0644", "-o", "root", "-g", "root",
                                               "-T", "/dev/stdin", tmp], root=True, stdin=data),
                step("Put it in place", ["/usr/bin/mv", "-f", "-T", "--", tmp, path], root=True)]
    write, move = pair(new.encode())
    write["say"] = say
    # Shown instead of the whole file: the exact change, with a line of the
    # untouched text around it.
    write["diff"] = "".join(difflib.unified_diff(old.splitlines(keepends=True), new.splitlines(keepends=True),
                                                 fromfile=path, tofile=path + " (new)", n=1))
    move["verify"] = (path, new.encode(), pair(old.encode()))
    return [write, move]


def _hosts_text():
    raw = read_root_file(HOSTS)
    return raw.decode("utf-8", "replace") if raw is not None else None


def _hosts_state(text_value):
    if text_value is None:
        return "na"
    if "# BEGIN black-ops" in text_value:
        return "blackops"
    begins = text_value.count(HOSTS_BEGIN)
    ends = text_value.count(HOSTS_END + "\n") + (1 if text_value.endswith(HOSTS_END) else 0)
    if begins == 1 and ends == 1:
        return "ours"
    if begins or ends:
        return "broken"          # a half-removed block: refuse to touch it
    return "off"


def _hosts_with(text_value):
    # A file without a final newline gets one; undo keeps it (harmless).
    body = text_value if text_value.endswith("\n") or not text_value else text_value + "\n"
    block = [HOSTS_BEGIN] + ["%s %s" % (addr, h) for h in TELEMETRY_HOSTS for addr in ("0.0.0.0", "::")] + [HOSTS_END]
    return body + "\n".join(block) + "\n"


def _hosts_without(text_value):
    out, inside = [], False
    for line in text_value.splitlines(keepends=True):
        if line.rstrip("\n") == HOSTS_BEGIN:
            inside = True
            continue
        if inside and line.rstrip("\n") == HOSTS_END:
            inside = False
            continue
        if not inside:
            out.append(line)
    return "".join(out)


# Avahi's parser has no trailing comments, so each marker is a line of its
# own above the line it marks.
AVAHI_MARK = "# keepwell: the next line was added by the Keepwell plugin"
AVAHI_ON = "disable-publishing=yes"
AVAHI_WAS = "#keepwell-was: "
AVAHI_SECTION_MARK = "# keepwell: the next section was added by the Keepwell plugin"


def _avahi_state(text_value):
    if text_value is None or not _active("avahi-daemon.service"):
        return "na"
    if "black-ops" in text_value:
        return "blackops"
    if AVAHI_MARK in text_value:
        return "ours"
    section = ""
    for line in text_value.splitlines():
        t = line.strip()
        if t.startswith("[") and "]" in t:
            section = t[1:t.index("]")]
        elif section == "publish" and re.fullmatch(r"disable-publishing\s*=\s*yes", t):
            return "other"
    return "off"


def _avahi_with(text_value):
    out, section, done = [], "", False
    for line in text_value.splitlines(keepends=True):
        t = line.strip()
        if t.startswith("[") and "]" in t:
            section = t[1:t.index("]")]
        if not done and section == "publish" and re.fullmatch(r"#?\s*disable-publishing\s*=.*", t):
            out += [line if t.startswith("#") else AVAHI_WAS + line, AVAHI_MARK + "\n", AVAHI_ON + "\n"]
            done = True
            continue
        out.append(line)
    if not done:
        if out and not out[-1].endswith("\n"):
            out[-1] += "\n"
        out += [AVAHI_SECTION_MARK + "\n", "[publish]\n", AVAHI_MARK + "\n", AVAHI_ON + "\n"]
    return "".join(out)


def _avahi_without(text_value):
    """Exactly our lines out: a marker and the one line after it, and a
    line we commented out put back."""
    lines = text_value.splitlines(keepends=True)
    out, skip = [], 0
    for i, line in enumerate(lines):
        if skip:
            skip -= 1
            continue
        bare = line.rstrip("\n")
        nxt = lines[i + 1].rstrip("\n") if i + 1 < len(lines) else None
        if bare == AVAHI_MARK and nxt == AVAHI_ON:
            skip = 1
            continue
        if bare == AVAHI_SECTION_MARK and nxt == "[publish]":
            skip = 1
            continue
        out.append(line[len(AVAHI_WAS):] if line.startswith(AVAHI_WAS) else line)
    return "".join(out)


def _session_env(name):
    for line in capture(["/usr/bin/systemctl", "--user", "show-environment"], timeout=3).splitlines():
        if line.startswith(name + "="):
            return line[len(name) + 1:].strip("$'\" ")
    return None


def _privacy_state():
    """id -> (state, label, cost). state: ours | off | other | blackops | na | broken."""
    st = {}
    hosts = _hosts_text()
    st["hosts"] = (_hosts_state(hosts), "Block telemetry hosts",
                   "14 analytics and crash-report servers · sites that use Google Analytics stop counting your visits; nothing else changes")
    if not _active("systemd-resolved.service"):
        fb = "na"
    elif os.path.exists(RESOLVED_FILE):
        fb = "ours"
    elif os.path.exists("/etc/systemd/resolved.conf.d/no-fallback.conf"):
        fb = "blackops"
    else:
        cfg = capture(["/usr/bin/systemd-analyze", "cat-config", "systemd/resolved.conf"], timeout=4)
        vals = re.findall(r"(?m)^\s*FallbackDNS\s*=(.*)$", cfg)
        fb = "other" if vals and not vals[-1].strip() else "off"
    st["fallback"] = (fb, "No backup DNS servers",
                      "if your network's DNS stops answering, names stop resolving instead of quietly asking Quad9, Cloudflare or Google")
    nm = _active("NetworkManager.service")
    bo_nm = any(os.path.exists("/etc/NetworkManager/conf.d/" + n)
                for n in ("90-black-ops-identity.conf", "90-black-ops-connectivity.conf"))
    st["connectivity"] = ("na" if not nm else "ours" if os.path.exists(NM_CONNECTIVITY) else "blackops" if bo_nm else "off",
                          "No connection check",
                          "NetworkManager stops asking ping.archlinux.org; Wi-Fi sign-in pages (hotels, cafés) won't open by themselves")
    st["identity"] = ("na" if not nm else "ours" if os.path.exists(NM_IDENTITY) else "blackops" if bo_nm else "off",
                      "Private network identity",
                      "a different hardware address for each network and no computer name sent; takes effect when you next connect")
    avahi = read_root_file(AVAHI, 256 * 1024)
    st["avahi"] = (_avahi_state(avahi.decode("utf-8", "replace") if avahi is not None else None),
                   "Don't announce this computer",
                   "other devices stop seeing this computer's name on the local network; printers and sharing you start still work")
    urls = _session_env("DEBUGINFOD_URLS")
    st["debuginfod"] = ("ours" if os.path.exists(ENV_DEBUGINFOD) else "other" if urls == "" else "off",
                        "No debug symbol lookups",
                        "crash reports and debuggers stop downloading symbols from debuginfod.archlinux.org; fully from next login")
    dnt = _session_env("DO_NOT_TRACK")
    st["dnt"] = ("ours" if os.path.exists(ENV_DNT) else "other" if dnt == "1" else "off",
                 "Send Do Not Track to apps",
                 "sets DO_NOT_TRACK=1 for apps started from now on; tools that honour it stop sending usage data")
    return st


def _privacy_options():
    opts = []
    for key, (state, label, cost) in _privacy_state().items():
        if state in ("ours", "off"):
            opts.append(dict(id=key, label=label, hint=cost, default=state == "ours"))
    return opts


def _privacy_steps(chosen):
    st = _privacy_state()
    steps = []

    def wants(key):
        state = st[key][0]
        if state not in ("ours", "off"):
            return None
        on = key in chosen
        return None if on == (state == "ours") else on

    w = wants("hosts")
    if w is not None:
        text_value = _hosts_text()
        new = _hosts_with(text_value) if w else _hosts_without(text_value)
        steps += _replace_root("Add the telemetry block to /etc/hosts" if w else "Take the Keepwell block out of /etc/hosts",
                               HOSTS, new, text_value)
        steps.append(step("Forget cached lookups", ["/usr/bin/resolvectl", "flush-caches"], root=True))

    w = wants("fallback")
    if w is not None:
        steps.append(_write_root("Turn off backup DNS servers", RESOLVED_FILE,
                                 HEADER + "[Resolve]\nFallbackDNS=\n") if w
                     else _remove_root("Remove Keepwell's DNS setting", RESOLVED_FILE))
        steps.append(step("Reload the DNS resolver", ["/usr/bin/systemctl", "try-reload-or-restart", "systemd-resolved.service"], root=True))

    nm_changed = False
    w = wants("connectivity")
    if w is not None:
        nm_changed = True
        steps.append(_write_root("Turn off the connection check", NM_CONNECTIVITY,
                                 HEADER + "[connectivity]\nenabled=false\n") if w
                     else _remove_root("Remove Keepwell's connection-check setting", NM_CONNECTIVITY))
    w = wants("identity")
    if w is not None:
        nm_changed = True
        steps.append(_write_root("Use a private identity on every network", NM_IDENTITY,
                                 HEADER + "[connection]\nipv4.dhcp-send-hostname=0\nipv6.dhcp-send-hostname=0\n"
                                 "wifi.cloned-mac-address=stable\nethernet.cloned-mac-address=stable\nipv6.ip6-privacy=2\n") if w
                     else _remove_root("Remove Keepwell's network identity setting", NM_IDENTITY))
    if nm_changed:
        steps.append(step("Reload NetworkManager's settings", ["/usr/bin/systemctl", "reload", "NetworkManager.service"], root=True))

    w = wants("avahi")
    if w is not None:
        old = read_root_file(AVAHI, 256 * 1024).decode("utf-8", "replace")
        new = _avahi_with(old) if w else _avahi_without(old)
        steps += _replace_root("Stop announcing this computer" if w else "Take Keepwell's line out of Avahi's settings",
                               AVAHI, new, old)
        steps.append(step("Restart Avahi", ["/usr/bin/systemctl", "try-restart", "avahi-daemon.service"], root=True))

    w = wants("debuginfod")
    if w is not None:
        if w:
            steps.append(step("Turn off debug symbol lookups for new sessions",
                              ["/usr/bin/install", "-D", "-m", "0644", "-T", "/dev/stdin", ENV_DEBUGINFOD],
                              stdin=(HEADER + "export DEBUGINFOD_URLS=\n").encode()))
            steps.append(step("…and for apps started from now on",
                              ["/usr/bin/systemctl", "--user", "set-environment", "DEBUGINFOD_URLS="]))
        else:
            steps.append(step("Remove Keepwell's debug symbol setting", ["/usr/bin/rm", "-f", "--", ENV_DEBUGINFOD]))
            steps.append(step("…and stop applying it to apps started from now on",
                              ["/usr/bin/systemctl", "--user", "unset-environment", "DEBUGINFOD_URLS"]))

    w = wants("dnt")
    if w is not None:
        if w:
            steps.append(step("Send Do Not Track in new sessions",
                              ["/usr/bin/install", "-D", "-m", "0644", "-T", "/dev/stdin", ENV_DNT],
                              stdin=(HEADER + "export DO_NOT_TRACK=1\n").encode()))
            steps.append(step("…and to apps started from now on",
                              ["/usr/bin/systemctl", "--user", "set-environment", "DO_NOT_TRACK=1"]))
        else:
            steps.append(step("Remove Keepwell's Do Not Track setting", ["/usr/bin/rm", "-f", "--", ENV_DNT]))
            steps.append(step("…and stop sending it to apps started from now on",
                              ["/usr/bin/systemctl", "--user", "unset-environment", "DO_NOT_TRACK"]))
    return steps


def _policy_on():
    return [_write_root("Install the privacy policy", POLICY, json.dumps(CHROMIUM_POLICIES, indent=2) + "\n")]


def _policy_off():
    return [_remove_root("Remove Keepwell's privacy policy", POLICY)] if os.path.exists(POLICY) else []


def _snapshot():
    return step("Create a system snapshot", [OMARCHY, "snapshot", "create"], password=True)


def plan(action_id, snapshot, chosen=None):
    a = ACTIONS[action_id]
    options = a["options"]() if "options" in a else []
    ids = {o["id"] for o in options}
    if chosen is None:
        chosen = {o["id"] for o in options if o["default"]}
    chosen = set(chosen) & ids
    steps = a["steps"](chosen)
    if snapshot and a.get("system") and steps:
        steps = [_snapshot()] + steps
    return {
        "id": action_id, "title": a["title"], "summary": a["summary"],
        "snapshotOffered": a["system"],
        "options": [{"id": o["id"], "label": o["label"], "hint": o["hint"], "checked": o["id"] in chosen}
                    for o in options],
        "steps": [dict({"say": s["say"], "cmd": shlex.join(s["argv"]), "root": s["root"]},
                       **({"diff": s["diff"]} if s["diff"] is not None
                          else {"content": s["stdin"].decode("utf-8", "replace")} if s["stdin"] is not None else {}))
                  for s in steps],
        "_steps": steps,
    }


# ---------------------------------------------------------------- terminal

BOLD, DIM, RESET = "\033[1m", "\033[2m", "\033[0m"


def _trusted(program):
    """A program we run must be a root-owned file that others can't write.
    Checked just before its step, since an earlier step may install it."""
    try:
        st = os.stat(program)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == 0 and not st.st_mode & 0o022


def run_step(raw):
    argv = raw["argv"]
    program = argv[2] if argv[0] == SUDO else argv[0]
    if not _trusted(argv[0]) or not _trusted(program):
        print(f"Stopped: {program} is missing or not a root-owned system program.")
        return 2
    try:
        if raw["stdin"] is None:
            return subprocess.call(argv, env=ENV)
        proc = subprocess.Popen(argv, env=ENV, stdin=subprocess.PIPE)
        proc.communicate(raw["stdin"])
        return proc.returncode
    except KeyboardInterrupt:
        return 130
    except OSError as e:
        print(f"Couldn't start {argv[0]}: {e.strerror}")
        return 127


def read_root_file(path, cap=1 << 20):
    """Bytes of a file in a root-owned directory, without following a
    symlink at the end, or None."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > cap:
            return None
        os.set_blocking(fd, True)
        data = b""
        while len(data) <= cap:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        return data if len(data) <= cap else None
    finally:
        os.close(fd)


def wait_enter(prompt):
    try:
        input(prompt)
        return True
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def apply(action_id, snapshot, chosen=None):
    p = plan(action_id, snapshot, chosen)
    print(f"\n{BOLD}Keepwell · {p['title']}{RESET}\n")
    print(p["summary"] + "\n")
    if not p["steps"]:
        print("Nothing to do: none of the options are chosen, or there is nothing left to remove.")
        wait_enter("\nPress Enter to close and return to Keepwell. ")
        return 0
    print("These commands will run, in order:\n")
    for n, s in enumerate(p["steps"], 1):
        print(f"  {n}. {s['say']}")
        print(f"     {DIM}${RESET} {s['cmd']}")
        if "diff" in s:
            print(f"     {DIM}changing only these lines (+ added, - removed):{RESET}")
            for line in s["diff"].splitlines()[2:]:
                print(f"     {DIM}│{RESET} {line}")
        elif "content" in s:
            print(f"     {DIM}with these contents:{RESET}")
            for line in s["content"].splitlines() or [""]:
                print(f"     {DIM}│{RESET} {line}")
    if any(s["root"] for s in p["steps"]):
        print(f"\n{DIM}Steps marked with sudo or that install packages will ask for your password here.{RESET}")
    if not wait_enter(f"\n{BOLD}Press Enter to run them{RESET}, or close this window to cancel. "):
        return 130
    for n, (s, raw) in enumerate(zip(p["steps"], p["_steps"]), 1):
        print(f"\n{BOLD}[{n}/{len(p['steps'])}] {s['say']}{RESET}")
        rc = run_step(raw)
        if rc == 0 and raw["verify"]:
            path, expected, rollback = raw["verify"]
            if read_root_file(path) != expected:
                print(f"{BOLD}{path} doesn't hold what was written.{RESET} Putting the original back:")
                for r in rollback:
                    print(f"  $ {shlex.join(r['argv'])}")
                    run_step(r)
                rc = 3
        if rc != 0:
            print(f"\n{BOLD}Step {n} did not finish (exit {rc}).{RESET} Nothing after it was run.")
            wait_enter("\nPress Enter to close and return to Keepwell. ")
            return rc
    print(f"\n{BOLD}Done.{RESET}")
    wait_enter("\nPress Enter to close and return to Keepwell. ")
    return 0


# ---------------------------------------------------------------- background scans
# Long, read-only scans run as transient user services rather than in a
# terminal: independent of the shell (they survive a restart), at idle CPU
# and disk priority, one of each kind at a time, and they send one desktop
# notification when they finish. Nothing they find is changed or deleted.

UNITS = {"clamscan": "keepwell-clamscan.service", "gitleaks": "keepwell-gitleaks.service",
         "osv": "keepwell-osv.service"}


def _background(unit, kind, argv, quiet=False):
    if capture(["/usr/bin/systemctl", "--user", "is-active", unit], timeout=3, cap=256).strip() in ("active", "activating"):
        return {"started": False, "reason": "running"}
    # When the scan ends, this script (from its own absolute path) reads the
    # result, sends one notification that says it, and asks Keepwell to
    # check again, so the window already shows it.
    me = os.path.realpath(__file__)
    if not re.fullmatch(r"/[A-Za-z0-9/._@+-]+", me):
        return {"started": False, "reason": "path"}
    notify = "ExecStopPost=/usr/bin/python3 -I -S %s notify %s%s" % (me, kind, " --quiet" if quiet else "")
    rc = subprocess.call(["/usr/bin/systemd-run", "--user", "--quiet", "--collect", "--unit=" + unit,
                          "--property=Nice=19", "--property=IOSchedulingClass=idle",
                          "--property=" + notify, "--"] + argv,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         env={"PATH": "/usr/bin", "HOME": HOME,
                              "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", ""),
                              "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")},
                         timeout=15)
    return {"started": rc == 0}


def start_scan(target, quiet=False):
    if not _trusted("/usr/bin/clamscan"):
        return {"started": False, "reason": "missing"}
    path = os.path.join(HOME, "Downloads") if target == "downloads" else HOME
    log = keepwell_state.new_log(target)
    argv = ["/usr/bin/clamscan", "--recursive", "--infected", "--log=" + log]
    if target == "home":
        # Caches, the Trash and Keepwell's own logs: rebuilt, already
        # discarded, or written by the scan itself.
        for sub in (".cache", ".local/share/Trash", ".local/state/keepwell"):
            argv.append("--exclude-dir=^" + re.escape(os.path.join(HOME, sub)) + "(/|$)")
    return _background(UNITS["clamscan"], "clamscan", argv + ["--", path], quiet)


def _scan_root(folder):
    """A folder to scan for projects, as a real absolute path, or None."""
    if folder == "~":
        folder = HOME
    elif folder.startswith("~/"):
        folder = os.path.join(HOME, folder[2:])
    real = os.path.realpath(folder)
    if not os.path.isabs(folder) or not os.path.isdir(real) or real in ("/", "/usr", "/etc", "/proc", "/sys"):
        return None
    return real


def start_leaks(folder, quiet=False):
    if not _trusted("/usr/bin/gitleaks"):
        return {"started": False, "reason": "missing"}
    real = _scan_root(folder)
    if not real:
        return {"started": False, "reason": "folder"}
    me = os.path.realpath(__file__)
    return _background(UNITS["gitleaks"], "gitleaks",
                       ["/usr/bin/python3", "-I", "-S", me, "leaks-scan", real], quiet)


def start_osv(folder, quiet=False):
    if not _trusted("/usr/bin/osv-scanner"):
        return {"started": False, "reason": "missing"}
    real = _scan_root(folder)
    if not real:
        return {"started": False, "reason": "folder"}
    me = os.path.realpath(__file__)
    return _background(UNITS["osv"], "osv", ["/usr/bin/python3", "-I", "-S", me, "osv-scan", real], quiet)


# osv-scanner reports each vulnerability as a full OSV record; a group joins
# records that are the same problem under different ids (GHSA, CVE, a
# language database). Severity is the group's max_severity (a CVSS score)
# when present, else the advisory's own rating.
SEVERITY_WORDS = {"CRITICAL": "Critical", "HIGH": "High", "MODERATE": "Medium", "MEDIUM": "Medium", "LOW": "Low"}
SEVERITY_ORDER = {"Critical": 0, "High": 1, "Medium": 2, "Low": 3, "Unknown": 4}


def _severity(group, record):
    score = group.get("max_severity") if isinstance(group, dict) else None
    try:
        n = float(score)
    except (TypeError, ValueError):
        n = None
    if n is not None and n > 0:
        return "Critical" if n >= 9 else "High" if n >= 7 else "Medium" if n >= 4 else "Low"
    rating = ((record or {}).get("database_specific") or {}).get("severity")
    return SEVERITY_WORDS.get(str(rating).upper(), "Unknown")


def _fixed_in(record, name):
    """Versions that fix this record for this package, from its affected
    ranges (the OSV schema's events[].fixed)."""
    out = []
    for aff in (record or {}).get("affected") or []:
        if not isinstance(aff, dict) or (aff.get("package") or {}).get("name") != name:
            continue
        for rng in aff.get("ranges") or []:
            # GIT ranges name commits, not versions anyone can update to.
            if not isinstance(rng, dict) or rng.get("type") == "GIT":
                continue
            for ev in rng.get("events") or []:
                fixed = (ev or {}).get("fixed")
                if isinstance(fixed, str) and re.fullmatch(r"[A-Za-z0-9.+~_:-]{1,64}", fixed) \
                        and not re.fullmatch(r"[0-9a-f]{40}", fixed) and fixed not in out:
                    out.append(fixed)
    return out[:3]


def _osv_findings(doc, repo, root):
    findings = []
    for res in (doc.get("results") or [])[:500]:
        source = str(((res or {}).get("source") or {}).get("path", ""))
        lockfile = os.path.relpath(source, repo) if source.startswith(repo) else os.path.basename(source)
        for p in ((res or {}).get("packages") or [])[:2000]:
            pkg = (p or {}).get("package") or {}
            name, version = str(pkg.get("name", "")), str(pkg.get("version", ""))
            records = {str(v.get("id")): v for v in (p.get("vulnerabilities") or []) if isinstance(v, dict)}
            groups = [g for g in (p.get("groups") or []) if isinstance(g, dict) and g.get("ids")] or \
                [{"ids": [i]} for i in records]
            vulns = []
            for g in groups[:50]:
                ids = [str(i) for i in g["ids"] if isinstance(i, str)]
                group_records = [records[i] for i in ids if i in records]
                record = group_records[0] if group_records else {}
                aliases = ids + [str(a) for a in (g.get("aliases") or []) if isinstance(a, str)] + \
                    [str(a) for r in group_records for a in (r.get("aliases") or []) if isinstance(a, str)]
                cve = next((a for a in aliases if re.fullmatch(r"CVE-\d{4}-\d{4,7}", a)), "")
                # Some databases (PYSEC) have no one-line summary, only details;
                # take a summary from any record in the group, else details' first sentence.
                summary = next((str(r["summary"]) for r in group_records if r.get("summary")), "")
                if not summary:
                    details = next((str(r["details"]) for r in group_records if r.get("details")), "")
                    summary = re.split(r"(?<=[.!?])\s|\n", details.strip(), 1)[0] if details else ""
                fixed = []
                for r in group_records:
                    fixed += [f for f in _fixed_in(r, name) if f not in fixed]
                vulns.append({"id": re.sub(r"[^A-Za-z0-9._:-]", "", ids[0])[:64], "cve": cve,
                              "severity": _severity(g, record), "fixed": fixed[:3],
                              "summary": _plain(summary, 160)})
            if not vulns or not name:
                continue
            vulns.sort(key=lambda v: SEVERITY_ORDER[v["severity"]])
            findings.append({
                "repo": (os.path.relpath(repo, root) if repo != root else os.path.basename(root))[:120],
                "file": _plain(lockfile, 160), "ecosystem": _plain(str(pkg.get("ecosystem", "")), 32),
                "package": _plain(name, 128), "version": _plain(version, 64),
                "severity": vulns[0]["severity"], "vulns": vulns[:8], "count": len(vulns),
                "fixable": all(v["fixed"] for v in vulns)})
    return findings


def osv_scan(root):
    """Runs inside the background unit. One osv-scanner run per project, so a
    huge folder can't stall the rest; a summary of what was found is kept."""
    started = int(time.time())
    repos = find_repos(root)
    findings, scanned, failed, empty = [], 0, 0, 0
    for repo in repos:
        if not repo.startswith("/"):
            continue
        # 0 nothing found, 1 vulnerabilities, 128 no dependency files. Any
        # other ending (offline, OSV.dev unreachable, timeout) is a failure,
        # never "nothing found".
        out = capture(["/usr/bin/osv-scanner", "scan", "source", "-r", "--format", "json", repo],
                      timeout=300, cap=64 << 20, ok_codes=(0, 1, 128), failed=None)
        if out is None:
            failed += 1
            continue
        try:
            doc = json.loads(out) if out.strip() else {"results": []}
        except ValueError:
            failed += 1
            continue
        if not isinstance(doc, dict):
            failed += 1
            continue
        scanned += 1
        if not doc.get("results"):
            empty += 1
        findings += _osv_findings(doc, repo, root)
    findings.sort(key=lambda f: (SEVERITY_ORDER[f["severity"]], not f["fixable"]))
    summary = {"at": started, "folder": root.replace(HOME, "~", 1)[:200], "repos": len(repos),
               "scanned": scanned, "failed": failed, "noLockfiles": empty,
               "packages": len(findings), "findings": findings[:100], "finished": True}
    keepwell_state.write("osv.json", json.dumps(summary, separators=(",", ":")).encode())
    return 0


def _plain(text_value, limit):
    """Notification bodies are markup to the notification daemon: no tags,
    no entities, no control characters, and short."""
    text_value = re.sub(r"[\x00-\x1f\x7f<>&]", "", text_value)
    return text_value[:limit]


def notify(kind, quiet=False):
    if quiet:
        _refresh()
        return 0
    if kind == "clamscan":
        found = keepwell_state.latest_log()
        log = found[1].decode("utf-8", "replace") if found and found[1] else ""
        where = "Home folder" if found and found[0].endswith("-home.log") else "Downloads"
        if "----------- SCAN SUMMARY -----------" not in log:
            title, body = "Virus scan stopped", where + ": stopped before the end."
        else:
            files = re.search(r"(?m)^Scanned files: (\d+)$", log)
            bad = re.search(r"(?m)^Infected files: (\d+)$", log)
            secs = re.search(r"(?m)^Time: ([0-9.]+) sec", log)
            n = int(bad.group(1)) if bad else 0
            took = (" in %d min" % round(float(secs.group(1)) / 60)) if secs and float(secs.group(1)) >= 90 \
                else (" in %d s" % round(float(secs.group(1)))) if secs else ""
            title = "Virus scan finished"
            body = "%s: %s, %s files checked%s." % (
                where, ("%d infected file%s found" % (n, "" if n == 1 else "s")) if n else "nothing found",
                files.group(1) if files else "?", took)
    elif kind == "osv":
        doc = keepwell_state.read_json("osv.json") or {}
        if not doc.get("finished") or not isinstance(doc.get("at"), int) or time.time() - doc["at"] > 86400:
            title, body = "Dependency scan stopped", "Stopped before the end."
        else:
            n = doc.get("packages", 0)
            fixable = sum(1 for f in doc.get("findings") or [] if f.get("fixable"))
            title = "Dependency scan finished" if not doc.get("failed") else "Dependency scan incomplete"
            body = ("%d package%s with known vulnerabilities (%d fixable)" % (n, "" if n == 1 else "s", fixable)
                    if n else "No known vulnerabilities") + " in %d project%s." % (doc.get("scanned", 0), "" if doc.get("scanned", 0) == 1 else "s") \
                + (" %d couldn't be checked (offline?)." % doc["failed"] if doc.get("failed") else "")
    else:
        doc = keepwell_state.read_json("gitleaks.json") or {}
        if not doc.get("finished") or not isinstance(doc.get("at"), int) or time.time() - doc["at"] > 86400:
            title, body = "Secrets scan stopped", "Stopped before the end."
        else:
            n, repos = len(doc.get("findings") or []), doc.get("scanned", 0)
            title = "Secrets scan finished"
            body = ("%d possible secret%s" % (n, "" if n == 1 else "s") if n else "No secrets found") + \
                " in %d repositor%s." % (repos, "y" if repos == 1 else "ies")
    _notify(title, body)
    return 0


def stop(kind):
    rc = subprocess.call(["/usr/bin/systemctl", "--user", "stop", "--", UNITS[kind]],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    return {"stopped": rc == 0}


def find_repos(root, limit=100, seconds=20.0):
    """Git repositories under root, at most four levels down, skipping
    hidden folders and ones that only ever hold dependencies.

    A symlinked folder is followed only when the folder it points to is
    yours (~/Projects -> /mnt/data/Projects is; a link into /, /usr or
    another account's files is not), and each real folder is visited once,
    so a link loop can't trap the walk or carry it outside your files."""
    skip = {"node_modules", ".cache", "vendor", ".venv", "venv", "target", "build", "dist"}
    found, deadline, seen = [], time.monotonic() + seconds, set()
    stack = [(root, 0)]
    while stack and len(found) < limit and time.monotonic() < deadline:
        path, depth = stack.pop()
        try:
            st = os.stat(path)
        except OSError:
            continue
        if (st.st_dev, st.st_ino) in seen:
            continue
        seen.add((st.st_dev, st.st_ino))
        try:
            with os.scandir(path) as it:
                entries = list(it)[:2000]
        except OSError:
            continue
        if any(e.name == ".git" for e in entries):
            found.append(path)
            continue
        if depth >= 4:
            continue
        for e in entries:
            if e.name in skip or e.name.startswith("."):
                continue
            try:
                if e.is_dir(follow_symlinks=False):
                    stack.append((e.path, depth + 1))
                elif e.is_symlink() and e.is_dir(follow_symlinks=True) \
                        and os.stat(e.path).st_uid == os.geteuid():
                    stack.append((e.path, depth + 1))
            except OSError:
                continue
    return sorted(found)


def leaks_scan(root):
    """Runs inside the background unit. Writes a summary with locations only:
    gitleaks redacts the secrets, and Keepwell keeps none of its text."""
    started = int(time.time())
    repos = find_repos(root)
    findings, scanned, failed = [], 0, 0
    for repo in repos:
        out = capture(["/usr/bin/gitleaks", "git", "--no-banner", "--redact", "--log-level", "error",
                       "--report-format", "json", "--report-path", "-", "--exit-code", "0",
                       "--timeout", "300", "--", repo], timeout=320, cap=16 << 20)
        try:
            items = json.loads(out) if out.strip() else []
        except ValueError:
            items = None
        if not isinstance(items, list):
            failed += 1
            continue
        scanned += 1
        rel = os.path.relpath(repo, root)
        for it in items[:200]:
            if not isinstance(it, dict) or len(findings) >= 200:
                continue
            findings.append({
                "repo": rel[:120] if rel != "." else os.path.basename(root)[:120],
                "file": str(it.get("File", ""))[:160],
                "line": it.get("StartLine") if isinstance(it.get("StartLine"), int) else 0,
                "rule": re.sub(r"[^A-Za-z0-9_.-]", "", str(it.get("RuleID", "")))[:48],
                "commit": re.sub(r"[^0-9a-f]", "", str(it.get("Commit", "")))[:8],
            })
    summary = {"at": started, "folder": root.replace(HOME, "~", 1)[:200], "repos": len(repos),
               "scanned": scanned, "failed": failed, "findings": findings, "finished": True}
    keepwell_state.write("gitleaks.json", json.dumps(summary, separators=(",", ":")).encode())
    return 0


# ---------------------------------------------------------------- schedules
# The deep scans' optional timer (see keepwell_schedule.py). A scheduled run
# that starts late doesn't run: it's recorded and reported as missed, so you
# choose when. Every run ends with one notification. Nothing is changed. The
# quick checks need no timer: the Keepwell service runs them hourly itself.

LEGACY_UNITS = ("keepwell-report.timer", "keepwell-report.service")


def _user_systemctl(*args):
    return subprocess.call(["/usr/bin/systemctl", "--user"] + list(args), stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)


def _cap(argv):
    return capture(argv, timeout=5, cap=8192)


def _migrate():
    """Earlier versions had one schedule (keepwell-report) and then a health
    timer. Quick checks now run by themselves, so both timers go; a virus scan
    the old schedule included carries over to the deep scans."""
    legacy_on = _cap(["/usr/bin/systemctl", "--user", "is-enabled", "keepwell-report.timer"]).strip() == "enabled"
    removed = False
    for timer, service in (("keepwell-report.timer", "keepwell-report.service"),
                           ("keepwell-health.timer", "keepwell-health.service")):
        if os.path.exists(os.path.join(HOME, ".config/systemd/user", timer)):
            _user_systemctl("disable", "--now", timer)
            keepwell_state.remove_unit(timer)
            keepwell_state.remove_unit(service)
            removed = True
    if removed:
        _user_systemctl("daemon-reload")
    if not legacy_on:
        return
    old = keepwell_state.read_json("schedule.json") or {}
    scans = [p for p in old.get("parts") or [] if p in ("scan-downloads", "scan-home")]
    if scans:
        days = ",".join(d for d in keepwell_schedule.DAYS if d in (old.get("days") or ["sat"]))
        schedule_set("deep", days, old.get("time") or "13:00", scans[0], "on")


def schedule_get():
    _migrate()
    return keepwell_schedule.status(_cap)


def schedule_set(kind, days_arg, at, parts_arg, battery="on"):
    if kind != "deep":
        return {"saved": False, "reason": "kind"}
    days = days_arg.split(",")
    if not days or any(d not in keepwell_schedule.DAYS for d in days) or len(set(days)) != len(days):
        return {"saved": False, "reason": "days"}
    if not keepwell_schedule.TIME.fullmatch(at):
        return {"saved": False, "reason": "time"}
    parts = parts_arg.split(",")
    if any(x not in keepwell_schedule.DEEP_PARTS for x in parts) or len(set(parts)) != len(parts) \
            or {"scan-downloads", "scan-home"} <= set(parts) or not parts:
        return {"saved": False, "reason": "parts"}
    if battery not in ("on", "off"):
        return {"saved": False, "reason": "battery"}
    timer, service = keepwell_schedule.units(kind)
    if not (keepwell_state.unit_free(service) and keepwell_state.unit_free(timer)):
        return {"saved": False, "reason": "exists"}
    me = os.path.realpath(__file__)
    if not re.fullmatch(r"/[A-Za-z0-9/._@+-]+", me):
        return {"saved": False, "reason": "path"}
    conf = keepwell_schedule.settings()
    old = conf[kind]
    new = {"days": [d for d in keepwell_schedule.DAYS if d in days], "time": at,
           # Slots before a change aren't "missed": the clock starts now.
           "since": int(time.time()) if (old.get("days"), old.get("time")) != (days, at) or not old.get("since") else old["since"]}
    new.update(parts=parts, battery=battery == "on")
    expr = keepwell_schedule.calendar(new)
    m = re.search(r"(?m)^\s*Next elapse: (.+)$", _cap(["/usr/bin/systemd-analyze", "calendar", "--", expr]))
    if not m:
        return {"saved": False, "reason": "calendar"}
    conf[kind] = new
    keepwell_schedule.save_settings(conf)
    mark = keepwell_state.UNIT_MARK.decode() + "; turn it off in Keepwell to remove it.\n"
    what = "deep scan"
    keepwell_state.write_unit(service, (mark +
        "[Unit]\nDescription=Keepwell scheduled %s (reads only; notifies, never changes anything)\n\n"
        "[Service]\nType=oneshot\nNice=19\nIOSchedulingClass=idle\nTimeoutStartSec=%s\n"
        "ExecStart=/usr/bin/python3 -I -S %s run %s --scheduled\n" % (what, "12h", me, kind)).encode())
    # No Persistent=: a run the computer slept or was off through is missed
    # and reported, not run late.
    keepwell_state.write_unit(timer, (mark +
        "[Unit]\nDescription=Keepwell %s schedule\n\n"
        "[Timer]\nOnCalendar=%s\nAccuracySec=1min\n\n[Install]\nWantedBy=timers.target\n" % (what, expr)).encode())
    if _user_systemctl("daemon-reload") != 0 or _user_systemctl("enable", "--now", timer) != 0:
        return {"saved": False, "reason": "systemd"}
    return {"saved": True, "next": m.group(1).strip()[:64]}


def schedule_off(kind):
    timer, service = keepwell_schedule.units(kind)
    _user_systemctl("disable", "--now", timer)
    keepwell_state.remove_unit(timer)
    keepwell_state.remove_unit(service)
    _user_systemctl("daemon-reload")
    return {"saved": True}


def on_battery():
    """True when a battery is present and no mains supply is online."""
    base, battery, mains = "/sys/class/power_supply", False, False
    for name in os.listdir(base) if os.path.isdir(base) else []:
        kind = (read_root_file(os.path.join(base, name, "type"), 64) or b"").strip()
        if kind == b"Battery":
            battery = True
        elif kind == b"Mains" and (read_root_file(os.path.join(base, name, "online"), 8) or b"").strip() == b"1":
            mains = True
    return battery and not mains


def _wait(unit, limit=12 * 3600):
    deadline = time.monotonic() + limit
    while time.monotonic() < deadline:
        if _cap(["/usr/bin/systemctl", "--user", "is-active", unit]).strip() not in ("active", "activating"):
            return
        time.sleep(5)


def _deep_summary(parts, started, skipped):
    said = list(skipped)
    if "scan-downloads" in parts or "scan-home" in parts:
        found = keepwell_state.latest_log()
        log = found[1].decode("utf-8", "replace") if found and found[1] and int(found[0][:10]) >= started - 5 else ""
        where = "home folder" if "scan-home" in parts else "Downloads"
        if not log:
            pass
        elif "----------- SCAN SUMMARY -----------" not in log:
            said.append("virus scan of %s stopped before the end" % where)
        else:
            bad = re.search(r"(?m)^Infected files: (\d+)$", log)
            n = int(bad.group(1)) if bad else 0
            said.append("virus scan of %s: %s" % (where, "%d infected file%s" % (n, "" if n == 1 else "s") if n else "nothing found"))
    for name, label, key in (("leaks", "secrets", "gitleaks.json"), ("osv", "dependencies", "osv.json")):
        if name not in parts:
            continue
        doc = keepwell_state.read_json(key) or {}
        if not isinstance(doc.get("at"), int) or doc["at"] < started - 5 or not doc.get("finished"):
            if not any(label in s_ for s_ in skipped):
                said.append("%s scan stopped before the end" % label)
            continue
        if name == "leaks":
            n = len(doc.get("findings") or [])
            said.append("%d possible secret%s" % (n, "" if n == 1 else "s") if n else "no secrets found")
        else:
            n = doc.get("packages", 0)
            if doc.get("failed") and not n:
                said.append("dependencies couldn't be checked (offline?)")
            else:
                said.append("%d dependenc%s with known vulnerabilities" % (n, "y" if n == 1 else "ies") if n
                            else "no vulnerable dependencies")
    text_value = "; ".join(said) or "nothing to scan"
    return text_value[:1].upper() + text_value[1:] + "."


def _scan_folder(state_name):
    doc = keepwell_state.read_json(state_name) or {}
    folder = doc.get("folder")
    return folder if isinstance(folder, str) and (folder == "~" or folder.startswith(("~/", "/"))) else "~"


def run(kind, scheduled):
    conf = keepwell_schedule.settings()[kind]
    started = int(time.time())
    if scheduled:
        slot = keepwell_schedule.last_slot(conf, started)
        if slot is None or started - slot > keepwell_schedule.LATE:
            # The computer was off, asleep or busy at the time: don't run late.
            return missed_notify()
    else:
        slot = None
    skipped, parts = [], conf["parts"]
    if conf["battery"] and on_battery():
        skipped.append("on battery: scans skipped")
        parts = []
    steps = []
    for part in parts:
        if part in ("scan-downloads", "scan-home"):
            steps.append(("clamscan", lambda p=part: start_scan(p[5:], quiet=True)))
        elif part == "leaks":
            steps.append(("gitleaks", lambda: start_leaks(_scan_folder("gitleaks.json"), quiet=True)))
        elif part == "osv":
            steps.append(("osv", lambda: start_osv(_scan_folder("osv.json"), quiet=True)))
    for unit_kind, start in steps:
        _wait(UNITS[unit_kind])                 # one you started by hand finishes first
        result = start()
        if result.get("reason") == "missing":
            skipped.append({"clamscan": "virus scan needs ClamAV", "gitleaks": "secrets scan needs gitleaks",
                            "osv": "dependencies scan needs osv-scanner"}[unit_kind])
            continue
        if result.get("started"):
            _wait(UNITS[unit_kind])
    summary = _deep_summary(conf["parts"] if parts else [], started, skipped)
    title = "Keepwell deep scan"
    keepwell_schedule.save_run(kind, at=started, end=int(time.time()), summary=summary,
                               **({"slot": slot} if slot else {}))
    _notify(title, summary)
    return 0


def missed_notify():
    """One notification per missed run, however often this is asked."""
    status = keepwell_schedule.status(_cap)
    done = keepwell_schedule.runs()
    for kind in keepwell_schedule.KINDS:
        slot = status[kind].get("missed")
        if not slot or done[kind].get("notified", 0) >= slot:
            continue
        keepwell_schedule.save_run(kind, notified=slot)
        what = "deep scan"
        _notify("Scheduled %s missed" % what,
                "The %s set for %s didn't run — the computer was off or asleep. Open Keepwell to run it now."
                % (what, time.strftime("%a %d %b, %H:%M", time.localtime(slot))))
    return 0


def run_now(kind):
    """Start a run from the window, independent of the shell."""
    me = os.path.realpath(__file__)
    unit = "keepwell-%s-now.service" % kind
    if _cap(["/usr/bin/systemctl", "--user", "is-active", unit]).strip() in ("active", "activating"):
        return {"started": False, "reason": "running"}
    rc = subprocess.call(["/usr/bin/systemd-run", "--user", "--quiet", "--collect", "--unit=" + unit,
                          "--property=Nice=19", "--property=IOSchedulingClass=idle", "--",
                          "/usr/bin/python3", "-I", "-S", me, "run", kind],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    return {"started": rc == 0}


def alert(items):
    """Called by the Keepwell service after each check with what needs
    attention now ("id:kind|title: status"). Notifies once for each that
    wasn't already flagged, and forgets ones that cleared, so they alert again
    if they come back."""
    seen = set((keepwell_state.read_json("alerts.json") or {}).get("ids") or [])
    now, new = {}, []
    for item in items[:40]:
        key, _, text_value = item.partition("|")
        if not re.fullmatch(r"[a-z]{2,16}:(crit|attn)", key) or not text_value:
            continue
        now[key] = text_value
        if key not in seen:
            new.append(_plain(text_value, 120))
    keepwell_state.write("alerts.json", json.dumps({"ids": sorted(now)}).encode())
    if new:
        _notify("Keepwell: needs your attention" if len(new) > 1 else "Keepwell", "; ".join(new[:4]) + ".")
    return {"notified": len(new)}


def _refresh():
    env = {"PATH": "/usr/bin", "HOME": HOME, "LANG": "C.UTF-8",
           "OMARCHY_PATH": os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"}
    env.update({k: os.environ[k] for k in ("DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "WAYLAND_DISPLAY") if k in os.environ})
    if _trusted("/usr/bin/omarchy-shell"):
        try:
            subprocess.call(["/usr/bin/omarchy-shell", "-q", "keepwell", "refresh"], stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass


def _notify(title, body):
    env = {"PATH": "/usr/bin", "HOME": HOME, "LANG": "C.UTF-8"}
    env.update({k: os.environ[k] for k in ("DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "WAYLAND_DISPLAY") if k in os.environ})
    if _trusted("/usr/bin/notify-send"):
        try:
            subprocess.call(["/usr/bin/notify-send", "--app-name=Keepwell", "--", _plain(title, 60), _plain(body, 240)],
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            env=env, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass
    _refresh()


def pending(args):
    if args == ["get"]:
        doc = keepwell_state.read_json("pending.json", cap=4096) or {}
        # A note older than a day is about a terminal long gone.
        if not isinstance(doc.get("at"), int) or time.time() - doc["at"] > 86400:
            doc = {}
        return doc
    if args == ["clear"]:
        keepwell_state.remove("pending.json")
        return {"cleared": True}
    if len(args) == 4 and args[0] == "set" and re.fullmatch(r"0x[0-9a-f]{1,16}|-", args[1]) \
            and re.fullmatch(r"[a-z]{1,16}", args[2]) and args[3] in ACTIONS:
        doc = {"at": int(time.time()), "address": args[1], "checkId": args[2], "act": args[3],
               "title": "Keepwell · " + ACTIONS[args[3]]["title"]}
        keepwell_state.write("pending.json", json.dumps(doc).encode())
        return {"saved": True}
    return None


def pick_folder():
    out = capture(["/usr/bin/zenity", "--file-selection", "--directory",
                   "--title=Choose a folder of projects", "--filename=" + HOME + "/"],
                  timeout=600, cap=8192, gui=True).strip()
    return {"folder": out if out.startswith("/") and "\n" not in out else ""}


# ---------------------------------------------------------------- Trash

CACHE = os.path.join(HOME, ".cache")
TRACES = {
    "recent": ("Recent files list", os.path.join(HOME, ".local", "share", "recently-used.xbel")),
    "history": ("Shell history", os.path.join(HOME, ".bash_history")),
    "thumbnails": ("Image thumbnails", os.path.join(CACHE, "thumbnails")),
}
NAME = re.compile(r"[A-Za-z0-9._@+-][A-Za-z0-9 ._@+-]{0,127}")


def tree_size(path, budget):
    """(bytes, complete) under path without following symlinks. budget is a
    shared [entries_left, deadline] so the whole listing stays bounded."""
    total, stack = 0, [path]
    try:
        st = os.lstat(path)
    except OSError:
        return 0, True
    if not stat.S_ISDIR(st.st_mode):
        return st.st_blocks * 512, True
    while stack:
        if budget[0] <= 0 or time.monotonic() > budget[1]:
            return total, False
        try:
            with os.scandir(stack.pop()) as it:
                for e in it:
                    budget[0] -= 1
                    try:
                        st = e.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if stat.S_ISDIR(st.st_mode):
                        stack.append(e.path)
                    else:
                        total += st.st_blocks * 512
        except OSError:
            continue
    return total, True


def _owned(path):
    try:
        st = os.lstat(path)
    except OSError:
        return None
    return st if st.st_uid == os.geteuid() else None


def resolve(which, item):
    """The absolute path for an item id, or None. Never a path from outside:
    traces come from a fixed map, cache items must be a plain name directly
    inside ~/.cache that you own, and an unclaimed item must still be one of
    the finder's candidates right now."""
    if which == "unclaimed":
        return keepwell_unclaimed.resolve(item)
    if which == "traces":
        entry = TRACES.get(item)
        return entry[1] if entry and _owned(entry[1]) else None
    if which == "cache":
        if not NAME.fullmatch(item) or item in (".", "..") or "/" in item:
            return None
        path = os.path.join(CACHE, item)
        return path if _owned(path) and os.path.dirname(path) == CACHE else None
    return None


def list_items(which):
    budget = [400000, time.monotonic() + 8]
    items = []
    if which == "unclaimed":
        found = keepwell_unclaimed.find()
        return {"set": which, "days": found["days"], "dayChoices": list(keepwell_unclaimed.DAY_CHOICES),
                "ignored": found["ignored"], "looked": found["looked"],
                "items": [{"id": c["id"], "label": c["id"].split("/")[-1], "path": c["path"],
                           "bytes": c["bytes"], "complete": True, "days": c["days"]} for c in found["items"]]}
    if which == "traces":
        for key, (label, path) in TRACES.items():
            if resolve("traces", key):
                size, complete = tree_size(path, budget)
                items.append({"id": key, "label": label, "path": path.replace(HOME, "~", 1),
                              "bytes": size, "complete": complete})
    else:
        try:
            with os.scandir(CACHE) as it:
                names = [e.name for n, e in enumerate(it) if n < 500]
        except OSError:
            names = []
        for name in names:
            path = resolve("cache", name)
            if not path or name == "thumbnails":    # thumbnails live under Activity traces
                continue
            size, complete = tree_size(path, budget)
            items.append({"id": name, "label": name, "path": "~/.cache/" + name,
                          "bytes": size, "complete": complete})
        items.sort(key=lambda i: -i["bytes"])
        items = items[:40]
    return {"set": which, "items": items}


def trash(which, ids):
    done, failed = [], []
    for item in ids[:100]:
        path = resolve(which, item)
        if not path:
            failed.append(item)
            continue
        out = subprocess.call(["/usr/bin/gio", "trash", "--", path], stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              env={"PATH": "/usr/bin", "HOME": HOME,
                                   "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", ""),
                                   "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")},
                              timeout=60)
        (done if out == 0 else failed).append(item)
    return {"set": which, "trashed": done, "failed": failed}


def main():
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] == "unclaimed":
        conf = keepwell_unclaimed.settings()
        if len(args) == 3 and args[1] == "days" and args[2].isdigit() and int(args[2]) in keepwell_unclaimed.DAY_CHOICES:
            keepwell_unclaimed.save_settings(int(args[2]), conf["ignored"])
        elif len(args) >= 3 and args[1] == "ignore" and all(keepwell_unclaimed._valid_id(a) for a in args[2:]):
            keepwell_unclaimed.save_settings(conf["days"], conf["ignored"] + args[2:52])
        elif args[1:] == ["unignore"]:
            keepwell_unclaimed.save_settings(conf["days"], [])
        else:
            return 2
        sys.stdout.write(json.dumps({"saved": True}))
        return 0
    if len(args) >= 2 and args[0] in ("list", "trash") and args[1] in ("cache", "traces", "unclaimed"):
        if args[0] == "list" and len(args) == 2:
            sys.stdout.write(json.dumps(list_items(args[1]), separators=(",", ":")))
            return 0
        if args[0] == "trash" and len(args) >= 3:
            sys.stdout.write(json.dumps(trash(args[1], args[2:]), separators=(",", ":")))
            return 0
        return 2
    if len(args) == 2 and args[0] == "scan" and args[1] in ("downloads", "home"):
        sys.stdout.write(json.dumps(start_scan(args[1])))
        return 0
    if len(args) == 2 and args[0] == "stop" and args[1] in UNITS:
        sys.stdout.write(json.dumps(stop(args[1])))
        return 0
    if len(args) == 2 and args[0] == "leaks":
        sys.stdout.write(json.dumps(start_leaks(args[1])))
        return 0
    if len(args) in (2, 3) and args[0] == "notify" and args[1] in UNITS and args[2:] in ([], ["--quiet"]):
        return notify(args[1], args[2:] == ["--quiet"])
    if len(args) == 2 and args[0] == "leaks-scan":
        return leaks_scan(args[1])
    if len(args) == 2 and args[0] == "osv":
        sys.stdout.write(json.dumps(start_osv(args[1])))
        return 0
    if len(args) == 2 and args[0] == "osv-scan":
        return osv_scan(args[1])
    if args == ["schedule", "get"]:
        sys.stdout.write(json.dumps(schedule_get()))
        return 0
    if len(args) == 3 and args[:2] == ["schedule", "off"] and args[2] in keepwell_schedule.KINDS:
        sys.stdout.write(json.dumps(schedule_off(args[2])))
        return 0
    if len(args) == 7 and args[:2] == ["schedule", "set"] and args[2] in keepwell_schedule.KINDS:
        sys.stdout.write(json.dumps(schedule_set(*args[2:])))
        return 0
    if len(args) == 3 and args[:2] == ["schedule", "dismiss"] and args[2] in keepwell_schedule.KINDS:
        slot = keepwell_schedule.status(_cap)[args[2]].get("missed")
        if slot:
            keepwell_schedule.save_run(args[2], dismissed=slot)
        sys.stdout.write(json.dumps({"saved": True}))
        return 0
    if args == ["schedule", "missed-notify"]:
        return missed_notify()
    if len(args) == 3 and args[:2] == ["schedule", "run-now"] and args[2] in keepwell_schedule.KINDS:
        sys.stdout.write(json.dumps(run_now(args[2])))
        return 0
    if len(args) in (2, 3) and args[0] == "run" and args[1] in keepwell_schedule.KINDS and args[2:] in ([], ["--scheduled"]):
        return run(args[1], args[2:] == ["--scheduled"])
    if len(args) >= 1 and args[0] == "alert":
        sys.stdout.write(json.dumps(alert(args[1:])))
        return 0
    if args == ["report"]:
        # The old single schedule's timer, until migration replaces it.
        _migrate()
        return 0
    if len(args) >= 2 and args[0] == "pending":
        out = pending(args[1:])
        if out is None:
            return 2
        sys.stdout.write(json.dumps(out))
        return 0
    if args == ["pick-folder"]:
        sys.stdout.write(json.dumps(pick_folder()))
        return 0
    if len(args) < 2 or args[0] not in ("plan", "apply") or args[1] not in ACTIONS:
        sys.stderr.write("usage: keepwell-run plan|apply <action> [--snapshot] [--with a,b] | list|trash <set> ...\n")
        return 2
    snapshot, chosen, rest = False, None, args[2:]
    while rest:
        if rest[0] == "--snapshot" and not snapshot:
            snapshot, rest = True, rest[1:]
        elif rest[0] == "--with" and chosen is None and len(rest) >= 2 \
                and re.fullmatch(r"(?:[a-z0-9]{1,24}(?:,[a-z0-9]{1,24}){0,15})?", rest[1]):
            chosen, rest = set(filter(None, rest[1].split(","))), rest[2:]
        else:
            return 2
    if args[0] == "plan":
        p = plan(args[1], snapshot, chosen)
        del p["_steps"]
        sys.stdout.write(json.dumps(p, separators=(",", ":")))
        return 0
    signal.signal(signal.SIGINT, signal.default_int_handler)
    return apply(args[1], snapshot, chosen)


if __name__ == "__main__":
    sys.exit(main())
