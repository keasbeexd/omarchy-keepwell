#!/usr/bin/python3 -I -S
"""Keepwell's action runner.

    keepwell-run plan  <action> [--snapshot] [--with a,b]   print the plan as JSON
    keepwell-run apply <action> [--snapshot] [--with a,b]   show the plan in this
                                    terminal, wait for Enter, then run it
    keepwell-run list  <set>                  items that can go to Trash, as JSON
    keepwell-run trash <set> <id>...          move those items to Trash
    keepwell-run schedule get | off deep | dismiss deep | run-now deep | missed-notify
    keepwell-run schedule set deep <days> <HH:MM> <parts> on|off
                                              the deep-scan schedule (keepwell_schedule.py);
                                              days like mon,wed; parts from
                                              scan-downloads, scan-home, leaks, osv;
                                              on|off: skip the scans on battery
    keepwell-run run deep [--scheduled]       one run: the scans, one notification,
                                              never any change
    keepwell-run alert <id:kind|text>...      notify once for each newly flagged check
    keepwell-run unclaimed days <n> | ignore <id>... | unignore
                                              the unclaimed finder's settings
    keepwell-run scan  downloads|home         start a ClamAV scan in the background
    keepwell-run leaks <folder>               start a gitleaks scan in the background
    keepwell-run osv <folder>                 start an osv-scanner scan in the background
    keepwell-run stop  clamscan|gitleaks|osv  stop that background scan
    keepwell-run notify clamscan|gitleaks     (run when a scan ends) say what it found,
                                              and tell Keepwell to check again
    keepwell-run pick-folder                  ask for a folder (zenity), print it as JSON
    keepwell-run pending set <addr> <check> <action> | get | clear
                                              the terminal Keepwell is waiting on, kept
                                              across a shell restart (omarchy update)

--with picks among an action's options (cleanup, for one); without it the
options marked safe are used. Sets for Trash are "cache" (folders in
~/.cache), "traces" (recent files, shell history, thumbnails) and
"unclaimed" (see keepwell_unclaimed.py); moving to Trash needs no root, and
everything moved can be restored from the Trash.

Both modes build the plan from the same table below, so the commands the
confirm dialog shows are the commands that run. Actions are a fixed set and
take no data from outside: nothing a file, a window title or another program
says can reach an argument.

Nothing here runs as root. Steps that need it call sudo (or an Omarchy
command that calls sudo) on a root-owned system binary with literal
arguments, in this visible terminal, so you see each command and type your
password here — never in Keepwell.
"""

import difflib
import json
import re
import select
import time
import os
import shlex
import signal
import stat
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import keepwell_state  # noqa: E402
import keepwell_unclaimed  # noqa: E402
import keepwell_schedule  # noqa: E402

OMARCHY = "/usr/bin/omarchy"
SUDO = "/usr/bin/sudo"
HOME = os.path.expanduser("~")
ENV = {
    "PATH": "/usr/share/omarchy/bin:/usr/bin",
    "HOME": HOME,
    "LANG": os.environ.get("LANG", "C.UTF-8"),
    "TERM": os.environ.get("TERM", "xterm-256color"),
}
for key in ("XDG_RUNTIME_DIR", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "OMARCHY_PATH", "USER", "LOGNAME"):
    if key in os.environ:
        ENV[key] = os.environ[key]


# What a graphical program (the folder picker) needs to open a window and
# look like the rest of the desktop; nothing else is passed on.
DISPLAY_ENV = ("WAYLAND_DISPLAY", "DISPLAY", "XDG_RUNTIME_DIR", "XDG_CURRENT_DESKTOP",
               "DBUS_SESSION_BUS_ADDRESS", "XCURSOR_SIZE", "XCURSOR_THEME", "GTK_THEME", "HOME", "LANG")


def capture(argv, timeout=10.0, cap=256 * 1024, gui=False, ok_codes=(0,), failed=""):
    """stdout of argv as text, or "" on failure, overrun or overflow. ok_codes:
    exit codes that count as success (some scanners exit 1 when they find
    something). failed: what to return when it didn't work — pass None
    where "no output" and "couldn't run" must not be confused."""
    env = {"PATH": "/usr/bin", "LC_ALL": "C"}
    # `systemctl --user` reaches your session's service manager through these.
    env.update({k: os.environ[k] for k in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS") if k in os.environ})
    if gui:
        env.update({k: os.environ[k] for k in DISPLAY_ENV if k in os.environ})
        env.pop("LC_ALL")
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, env=env,
                                cwd="/", start_new_session=True, close_fds=True)
    except OSError:
        return failed
    deadline, chunks, size, ok = time.monotonic() + timeout, [], 0, True
    fd = proc.stdout.fileno()
    while True:
        left = deadline - time.monotonic()
        if left <= 0:
            ok = False
            break
        if not select.select([fd], [], [], left)[0]:
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        size += len(chunk)
        if size > cap:
            ok = False
            break
        chunks.append(chunk)
    proc.stdout.close()
    if not ok:
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(proc.pid, sig)
                proc.wait(timeout=1)
                break
            except (ProcessLookupError, subprocess.TimeoutExpired):
                continue
        return failed
    try:
        proc.wait(timeout=max(0.1, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        return failed
    return b"".join(chunks).decode("utf-8", "replace") if proc.returncode in ok_codes else failed


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return (str(int(n)) if unit == "B" or n >= 100 else "%.1f" % n) + " " + unit
        n /= 1000.0


def size_from_human(text_value):
    m = re.fullmatch(r"\s*([0-9]+(?:\.[0-9]+)?)\s*(B|KiB|MiB|GiB|TiB)\s*", text_value)
    if not m:
        return 0
    return int(float(m.group(1)) * {"B": 1, "KiB": 1 << 10, "MiB": 1 << 20, "GiB": 1 << 30, "TiB": 1 << 40}[m.group(2)])


def paccache_dry(*flags):
    """(candidates, bytes) that `paccache -d <flags>` would remove."""
    out = capture(["/usr/bin/paccache", "-d"] + list(flags))
    m = re.search(r"finished dry run: (\d+) candidates \(disk space saved: ([^)]+)\)", out)
    return (int(m.group(1)), size_from_human(m.group(2))) if m else (0, 0)


def orphans():
    out = capture(["/usr/bin/pacman", "-Qtdq"])
    return [n for n in out.split() if re.fullmatch(r"[A-Za-z0-9@._+][A-Za-z0-9@._+-]{0,127}", n)][:50]


def step(say, argv, root=False, password=False, stdin=None, verify=None):
    """One command. root: run through sudo. password: the command may ask
    for your password itself (Omarchy commands that call sudo). stdin: bytes
    fed to the command (file contents; shown in full before anything runs).
    verify: (path, expected_bytes, rollback_steps) checked after this step;
    on a mismatch the rollback steps run at once."""
    full = [SUDO, "--"] + argv if root else argv
    return {"say": say, "argv": full, "root": root or password, "stdin": stdin, "verify": verify, "diff": None}


def pkg_add(*names):
    return step("Install " + ", ".join(names) + " from the Arch repositories",
                [OMARCHY, "pkg", "add"] + list(names), password=True)


