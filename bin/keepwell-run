#!/usr/bin/python3 -I -S
"""Keepwell's action runner.

    keepwell-run plan  <action> [--snapshot] [--with a,b]   print the plan as JSON
    keepwell-run apply <action> [--snapshot] [--with a,b]   show the plan in this
                                    terminal, wait for Enter, then run it
    keepwell-run list  <set>                  items that can go to Trash, as JSON
    keepwell-run trash <set> <id>...          move those items to Trash

--with picks among an action's options (cleanup, for one); without it the
options marked safe are used. Sets for Trash are "cache" (folders in
~/.cache) and "traces" (recent files, shell history, thumbnails); moving to
Trash needs no root, and everything moved can be restored from the Trash.

Both modes build the plan from the same table below, so the commands the
confirm dialog shows are the commands that run. Actions are a fixed set and
take no data from outside: nothing a file, a window title or another program
says can reach an argument.

Nothing here runs as root. Steps that need it call sudo (or an Omarchy
command that calls sudo) on a root-owned system binary with literal
arguments, in this visible terminal, so you see each command and type your
password here — never in Keepwell.
"""

import json
import re
import select
import time
import os
import shlex
import signal
import stat
import subprocess
import sys

OMARCHY = "/usr/bin/omarchy"
SUDO = "/usr/bin/sudo"
HOME = os.path.expanduser("~")
ENV = {
    "PATH": "/usr/share/omarchy/bin:/usr/bin",
    "HOME": HOME,
    "LANG": os.environ.get("LANG", "C.UTF-8"),
    "TERM": os.environ.get("TERM", "xterm-256color"),
}
for key in ("XDG_RUNTIME_DIR", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "OMARCHY_PATH", "USER", "LOGNAME"):
    if key in os.environ:
        ENV[key] = os.environ[key]


def capture(argv, timeout=10.0, cap=256 * 1024):
    """stdout of argv as text, or "" on failure, overrun or overflow."""
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, env={"PATH": "/usr/bin", "LC_ALL": "C"},
                                cwd="/", start_new_session=True, close_fds=True)
    except OSError:
        return ""
    deadline, chunks, size, ok = time.monotonic() + timeout, [], 0, True
    fd = proc.stdout.fileno()
    while True:
        left = deadline - time.monotonic()
        if left <= 0:
            ok = False
            break
        if not select.select([fd], [], [], left)[0]:
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        size += len(chunk)
        if size > cap:
            ok = False
            break
        chunks.append(chunk)
    proc.stdout.close()
    if not ok:
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(proc.pid, sig)
                proc.wait(timeout=1)
                break
            except (ProcessLookupError, subprocess.TimeoutExpired):
                continue
        return ""
    try:
        proc.wait(timeout=max(0.1, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        return ""
    return b"".join(chunks).decode("utf-8", "replace") if proc.returncode == 0 else ""


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return (str(int(n)) if unit == "B" or n >= 100 else "%.1f" % n) + " " + unit
        n /= 1000.0


def size_from_human(text_value):
    m = re.fullmatch(r"\s*([0-9]+(?:\.[0-9]+)?)\s*(B|KiB|MiB|GiB|TiB)\s*", text_value)
    if not m:
        return 0
    return int(float(m.group(1)) * {"B": 1, "KiB": 1 << 10, "MiB": 1 << 20, "GiB": 1 << 30, "TiB": 1 << 40}[m.group(2)])


def paccache_dry(*flags):
    """(candidates, bytes) that `paccache -d <flags>` would remove."""
    out = capture(["/usr/bin/paccache", "-d"] + list(flags))
    m = re.search(r"finished dry run: (\d+) candidates \(disk space saved: ([^)]+)\)", out)
    return (int(m.group(1)), size_from_human(m.group(2))) if m else (0, 0)


def orphans():
    out = capture(["/usr/bin/pacman", "-Qtdq"])
    return [n for n in out.split() if re.fullmatch(r"[A-Za-z0-9@._+][A-Za-z0-9@._+-]{0,127}", n)][:50]


def step(say, argv, root=False, password=False):
    """One command. root: run through sudo. password: the command may ask
    for your password itself (Omarchy commands that call sudo)."""
    full = [SUDO, "--"] + argv if root else argv
    return {"say": say, "argv": full, "root": root or password}


def pkg_add(*names):
    return step("Install " + ", ".join(names) + " from the Arch repositories",
                [OMARCHY, "pkg", "add"] + list(names), password=True)


# The action table. Each entry: title, what it does in plain words, and the
# steps. `system` marks actions that change installed software, where a
# snapshot first is offered. `options`, where present, lists choices the
# confirm sheet shows as checkboxes; `steps` receives the chosen ids.
ACTIONS = {
    "install-arch-audit": dict(
        title="Install arch-audit",
        summary="Adds the official tool that checks installed packages against Arch's security tracker.",
        system=True, steps=lambda o: [pkg_add("arch-audit")]),
    "install-clamav": dict(
        title="Install ClamAV",
        summary="Adds the ClamAV virus scanner and keeps its virus definitions up to date. Definitions download from ClamAV's servers.",
        system=True, steps=lambda o: [
            pkg_add("clamav"),
            step("Download virus definitions now", ["/usr/bin/freshclam"], root=True),
            step("Keep definitions up to date automatically",
                 ["/usr/bin/systemctl", "enable", "--now", "clamav-freshclam.service"], root=True)]),
    "freshclam-on": dict(
        title="Turn on definition updates",
        summary="Starts ClamAV's own updater, which checks ClamAV's servers for new virus definitions several times a day.",
        system=False, steps=lambda o: [
            step("Keep definitions up to date automatically",
                 ["/usr/bin/systemctl", "enable", "--now", "clamav-freshclam.service"], root=True)]),
    "scan-downloads": dict(
        title="Scan Downloads",
        summary="Scans your Downloads folder with ClamAV and lists anything infected. Nothing is deleted or moved.",
        system=False, steps=lambda o: [
            step("Scan ~/Downloads", ["/usr/bin/clamscan", "--recursive", "--infected", "--",
                                     os.path.join(HOME, "Downloads")])]),
    "install-gitleaks": dict(
        title="Install gitleaks",
        summary="Adds gitleaks, which finds passwords and keys committed to git repositories.",
        system=True, steps=lambda o: [pkg_add("gitleaks")]),
    "install-gufw": dict(
        title="Install GufW",
        summary="Adds GufW, a window for viewing and editing your firewall rules.",
        system=True, steps=lambda o: [pkg_add("gufw")]),
    "install-ufw": dict(
        title="Install and turn on the firewall",
        summary="Adds UFW, then blocks incoming connections and allows outgoing ones.",
        system=True, steps=lambda o: [pkg_add("ufw")] + _ufw_on()),
    "ufw-on": dict(
        title="Turn on the firewall",
        summary="Blocks incoming connections and allows outgoing ones, then switches the firewall on, now and at every start.",
        system=False, steps=lambda o: _ufw_on()),
    "ufw-deny-incoming": dict(
        title="Deny incoming connections",
        summary="Sets the firewall to block connections that start from outside. Rules you added are kept.",
        system=False, steps=lambda o: [
            step("Block incoming by default", ["/usr/bin/ufw", "default", "deny", "incoming"], root=True)]),
    "ufw-off": dict(
        title="Turn off the firewall",
        summary="Stops filtering connections. Your rules are kept and come back when you turn it on again.",
        system=False, steps=lambda o: [
            step("Switch the firewall off", ["/usr/bin/ufw", "disable"], root=True)]),
    "install-flatseal": dict(
        title="Install Flatseal",
        summary="Adds Flatseal, which shows and changes what each Flatpak app may access.",
        system=True, steps=lambda o: [pkg_add("flatseal")]),
    "install-baobab": dict(
        title="Install Disk Usage Analyzer",
        summary="Adds GNOME's Disk Usage Analyzer, which shows which folders take the most space.",
        system=True, steps=lambda o: [pkg_add("baobab")]),
    "update": dict(
        title="Update the system",
        summary="Runs Omarchy's own update: it takes a snapshot, then updates Omarchy and every package.",
        system=False, steps=lambda o: [step("Update Omarchy and all packages", [OMARCHY, "update"], password=True)]),
    "cleanup": dict(
        title="Clean up",
        summary="Removes what you tick. Package files are deleted outright; you can download them again any time.",
        system=True, options=lambda: _cleanup_options(), steps=lambda o: _cleanup_steps(o)),
    "snapshot": dict(
        title="Take a snapshot",
        summary="Creates a restore point of the system (not your home folder), which you can boot into from the boot menu.",
        system=False, steps=lambda o: [_snapshot()]),
}


def _ufw_on():
    return [
        step("Block incoming by default", ["/usr/bin/ufw", "default", "deny", "incoming"], root=True),
        step("Allow outgoing by default", ["/usr/bin/ufw", "default", "allow", "outgoing"], root=True),
        step("Switch the firewall on", ["/usr/bin/ufw", "enable"], root=True),
    ]


def _cleanup_options():
    opts = []
    n, b = paccache_dry("-k", "3")
    if n:
        opts.append(dict(id="pkg3", label="Old package versions", default=True,
                         hint="%s · keeps the newest 3 of each" % human(b)))
    n1, b1 = paccache_dry("-k", "1")
    if n1 > n:
        opts.append(dict(id="pkg1", label="All but the newest version", default=False,
                         hint="%s · advanced: no older version to go back to" % human(b1)))
    nu, bu = paccache_dry("-u", "-k", "0")
    if nu:
        opts.append(dict(id="uninstalled", label="Downloads of removed packages", default=True,
                         hint="%s · for packages no longer installed" % human(bu)))
    names = orphans()
    if names:
        more = " +%d" % (len(names) - 4) if len(names) > 4 else ""
        opts.append(dict(id="orphans", label="Unused packages: " + ", ".join(names[:4]) + more,
                         default=False, hint="advanced: installed as dependencies, nothing needs them now"))
    out = capture(["/usr/bin/journalctl", "--disk-usage"], timeout=5, cap=4096)
    m = re.search(r"take up ([0-9.]+)([KMGT]?)", out)
    opts.append(dict(id="journal", label="System logs older than two weeks", default=True,
                     hint=("logs use %s %sB now" % (m.group(1), m.group(2))) if m else "keeps the last two weeks"))
    return opts


def _cleanup_steps(chosen):
    steps = []
    if "pkg1" in chosen:
        steps.append(step("Delete all but the newest version of each package",
                          ["/usr/bin/paccache", "-r", "-k", "1"], root=True))
    elif "pkg3" in chosen:
        steps.append(step("Delete package versions older than the newest three",
                          ["/usr/bin/paccache", "-r", "-k", "3"], root=True))
    if "uninstalled" in chosen:
        steps.append(step("Delete downloads of packages that aren't installed",
                          ["/usr/bin/paccache", "-r", "-u", "-k", "0"], root=True))
    if "orphans" in chosen:
        names = orphans()
        if names:
            steps.append(step("Remove unused packages", ["/usr/bin/pacman", "-Rns", "--"] + names, root=True))
    if "journal" in chosen:
        steps.append(step("Delete system logs older than two weeks",
                          ["/usr/bin/journalctl", "--vacuum-time=2weeks"], root=True))
    return steps


def _snapshot():
    return step("Create a system snapshot", [OMARCHY, "snapshot", "create"], password=True)


def plan(action_id, snapshot, chosen=None):
    a = ACTIONS[action_id]
    options = a["options"]() if "options" in a else []
    ids = {o["id"] for o in options}
    if chosen is None:
        chosen = {o["id"] for o in options if o["default"]}
    chosen = set(chosen) & ids
    steps = a["steps"](chosen)
    if snapshot and a["system"] and steps:
        steps = [_snapshot()] + steps
    return {
        "id": action_id, "title": a["title"], "summary": a["summary"],
        "snapshotOffered": a["system"],
        "options": [{"id": o["id"], "label": o["label"], "hint": o["hint"], "checked": o["id"] in chosen}
                    for o in options],
        "steps": [{"say": s["say"], "cmd": shlex.join(s["argv"]), "root": s["root"]} for s in steps],
        "_argv": [s["argv"] for s in steps],
    }


# ---------------------------------------------------------------- terminal

BOLD, DIM, RESET = "\033[1m", "\033[2m", "\033[0m"


def _trusted(program):
    """A program we run must be a root-owned file that others can't write.
    Checked just before its step, since an earlier step may install it."""
    try:
        st = os.stat(program)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == 0 and not st.st_mode & 0o022


def wait_enter(prompt):
    try:
        input(prompt)
        return True
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def apply(action_id, snapshot, chosen=None):
    p = plan(action_id, snapshot, chosen)
    print(f"\n{BOLD}Keepwell · {p['title']}{RESET}\n")
    print(p["summary"] + "\n")
    if not p["steps"]:
        print("Nothing to do: none of the options are chosen, or there is nothing left to remove.")
        wait_enter("\nPress Enter to close and return to Keepwell. ")
        return 0
    print("These commands will run, in order:\n")
    for n, s in enumerate(p["steps"], 1):
        print(f"  {n}. {s['say']}")
        print(f"     {DIM}${RESET} {s['cmd']}")
    if any(s["root"] for s in p["steps"]):
        print(f"\n{DIM}Steps marked with sudo or that install packages will ask for your password here.{RESET}")
    if not wait_enter(f"\n{BOLD}Press Enter to run them{RESET}, or close this window to cancel. "):
        return 130
    for n, (s, argv) in enumerate(zip(p["steps"], p["_argv"]), 1):
        print(f"\n{BOLD}[{n}/{len(p['steps'])}] {s['say']}{RESET}")
        if not _trusted(argv[0]):
            print(f"Stopped: {argv[0]} is missing or not a root-owned system program. Nothing from here on was run.")
            wait_enter("\nPress Enter to close and return to Keepwell. ")
            return 2
        try:
            rc = subprocess.call(argv, env=ENV)
        except KeyboardInterrupt:
            rc = 130
        except OSError as e:
            print(f"Couldn't start {argv[0]}: {e.strerror}")
            rc = 127
        if rc != 0:
            print(f"\n{BOLD}Step {n} did not finish (exit {rc}).{RESET} Nothing after it was run.")
            wait_enter("\nPress Enter to close and return to Keepwell. ")
            return rc
    print(f"\n{BOLD}Done.{RESET}")
    wait_enter("\nPress Enter to close and return to Keepwell. ")
    return 0


# ---------------------------------------------------------------- Trash

CACHE = os.path.join(HOME, ".cache")
TRACES = {
    "recent": ("Recent files list", os.path.join(HOME, ".local", "share", "recently-used.xbel")),
    "history": ("Shell history", os.path.join(HOME, ".bash_history")),
    "thumbnails": ("Image thumbnails", os.path.join(CACHE, "thumbnails")),
}
NAME = re.compile(r"[A-Za-z0-9._@+-][A-Za-z0-9 ._@+-]{0,127}")


def tree_size(path, budget):
    """(bytes, complete) under path without following symlinks. budget is a
    shared [entries_left, deadline] so the whole listing stays bounded."""
    total, stack = 0, [path]
    try:
        st = os.lstat(path)
    except OSError:
        return 0, True
    if not stat.S_ISDIR(st.st_mode):
        return st.st_blocks * 512, True
    while stack:
        if budget[0] <= 0 or time.monotonic() > budget[1]:
            return total, False
        try:
            with os.scandir(stack.pop()) as it:
                for e in it:
                    budget[0] -= 1
                    try:
                        st = e.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if stat.S_ISDIR(st.st_mode):
                        stack.append(e.path)
                    else:
                        total += st.st_blocks * 512
        except OSError:
            continue
    return total, True


def _owned(path):
    try:
        st = os.lstat(path)
    except OSError:
        return None
    return st if st.st_uid == os.geteuid() else None


def resolve(which, item):
    """The absolute path for an item id, or None. Never a path from outside:
    traces come from a fixed map, cache items must be a plain name directly
    inside ~/.cache that you own."""
    if which == "traces":
        entry = TRACES.get(item)
        return entry[1] if entry and _owned(entry[1]) else None
    if which == "cache":
        if not NAME.fullmatch(item) or item in (".", "..") or "/" in item:
            return None
        path = os.path.join(CACHE, item)
        return path if _owned(path) and os.path.dirname(path) == CACHE else None
    return None


def list_items(which):
    budget = [400000, time.monotonic() + 8]
    items = []
    if which == "traces":
        for key, (label, path) in TRACES.items():
            if resolve("traces", key):
                size, complete = tree_size(path, budget)
                items.append({"id": key, "label": label, "path": path.replace(HOME, "~", 1),
                              "bytes": size, "complete": complete})
    else:
        try:
            with os.scandir(CACHE) as it:
                names = [e.name for n, e in enumerate(it) if n < 500]
        except OSError:
            names = []
        for name in names:
            path = resolve("cache", name)
            if not path or name == "thumbnails":    # thumbnails live under Activity traces
                continue
            size, complete = tree_size(path, budget)
            items.append({"id": name, "label": name, "path": "~/.cache/" + name,
                          "bytes": size, "complete": complete})
        items.sort(key=lambda i: -i["bytes"])
        items = items[:40]
    return {"set": which, "items": items}


def trash(which, ids):
    done, failed = [], []
    for item in ids[:100]:
        path = resolve(which, item)
        if not path:
            failed.append(item)
            continue
        out = subprocess.call(["/usr/bin/gio", "trash", "--", path], stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              env={"PATH": "/usr/bin", "HOME": HOME,
                                   "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", ""),
                                   "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")},
                              timeout=60)
        (done if out == 0 else failed).append(item)
    return {"set": which, "trashed": done, "failed": failed}


def main():
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] in ("list", "trash") and args[1] in ("cache", "traces"):
        if args[0] == "list" and len(args) == 2:
            sys.stdout.write(json.dumps(list_items(args[1]), separators=(",", ":")))
            return 0
        if args[0] == "trash" and len(args) >= 3:
            sys.stdout.write(json.dumps(trash(args[1], args[2:]), separators=(",", ":")))
            return 0
        return 2
    if len(args) < 2 or args[0] not in ("plan", "apply") or args[1] not in ACTIONS:
        sys.stderr.write("usage: keepwell-run plan|apply <action> [--snapshot] [--with a,b] | list|trash <set> ...\n")
        return 2
    snapshot, chosen, rest = False, None, args[2:]
    while rest:
        if rest[0] == "--snapshot" and not snapshot:
            snapshot, rest = True, rest[1:]
        elif rest[0] == "--with" and chosen is None and len(rest) >= 2 \
                and re.fullmatch(r"(?:[a-z0-9]{1,24}(?:,[a-z0-9]{1,24}){0,15})?", rest[1]):
            chosen, rest = set(filter(None, rest[1].split(","))), rest[2:]
        else:
            return 2
    if args[0] == "plan":
        p = plan(args[1], snapshot, chosen)
        del p["_argv"]
        sys.stdout.write(json.dumps(p, separators=(",", ":")))
        return 0
    signal.signal(signal.SIGINT, signal.default_int_handler)
    return apply(args[1], snapshot, chosen)


if __name__ == "__main__":
    sys.exit(main())
